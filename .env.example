# ==============================================================================
# DocShield AI — Environment Configuration Template
# Copy this file to .env and customize values for your deployment.
# NEVER commit .env to version control.
# ==============================================================================

# Application & Environment
APP_ENV=development
APP_NAME="DocShield AI"
DEBUG=true
SECRET_KEY=change-this-to-a-super-secret-random-32-byte-hex-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Host & Ports
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration
# For local dev, SQLite works out of the box: sqlite:///./docshield.db
# For PostgreSQL: postgresql+asyncpg://docshield:secret@localhost:5432/docshield_db
# Or synchronous: postgresql://docshield:secret@localhost:5432/docshield_db
DATABASE_URL=sqlite:///./docshield.db

# Storage Adapter
# Options: "local" or "s3"
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./storage

# S3 Configuration (Optional, required only if STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=docshield-documents
AWS_S3_ENDPOINT_URL=

# Queue & Background Workers
# Options: "inline" (instant in-process threadpool for local dev) or "celery" (Redis backed)
WORKER_MODE=inline
REDIS_URL=redis://localhost:6379/0

# OCR Configuration
# Options: "easyocr", "tesseract", "auto"
OCR_ENGINE=easyocr
OCR_LANGUAGES=["en"]
OCR_GPU=false

# External Verification Services (Mocked/Disabled if no credentials provided)
# Note: The system truthfully reports "Unavailable / Not configured" if credentials are missing
DIGILOCKER_ENABLED=false
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_API_URL=https://api.digitallocker.gov.in

# ML Model Configuration
ML_MODEL_PATH=ai/artifacts/docshield_classifier_v1.joblib
ML_CONFIDENCE_THRESHOLD=0.5
